# Copy to .env.local (git-ignored). Only public values belong here: VITE_* is compiled into the browser bundle.
# Deployment used by `npx convex dev` (written by the Convex CLI)
CONVEX_DEPLOYMENT=
# Public Convex URLs for the SPA
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Server secrets live ONLY in Convex env, never here:
#   npx convex env set GROKBOT_ALERT_WEBHOOK_URL <url> --prod   # monthly AI-spend alert webhook (the spend cron fails loudly if unset when the alert fires)
#   npx convex env set BB_TRUSTED_IPS "<ip>,<prefix>*" --prod     # optional: IPs that skip the per-IP start limit (set only while e2e/load run)
# The AI Gateway needs no key (getServiceToken).
